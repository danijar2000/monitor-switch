# Copy to install.conf (kept out of git) and fill in. Plain KEY=value lines;
# the file is read, not run.

# How this MacBook reaches the Mac mini over ssh. The Macs share a monitor and
# so a network: its .local name needs no VPN (add its host key to known_hosts).
MINI=user@mac-mini.local

# How the Mac mini reaches this MacBook. Defaults to $USER@<LocalHostName>.local;
# with Tailscale SSH enabled on the MacBook its Tailscale address cannot be used.
#MACBOOK=user@macbook.local

# The addresses each agent's ssh key is accepted from (sshd patterns, "*"
# matches anything). The key already runs only the peer commands; this list
# just keeps it to the home network. Exact addresses break whenever the router
# restarts and hands out new ones, so prefer the LAN with a wildcard plus
# link-local IPv6, which covers the .local names in any form sshd sees them:
#   "192.168.31.*,fe80::*"
# Exact addresses are stricter but need a DHCP reservation on the router.
# MACBOOK_FROM defaults to any address.
MINI_FROM="192.168.1.*,fe80::*"
#MACBOOK_FROM="192.168.1.*,fe80::*"

# Bluetooth addresses to hand over, keyboard first (see System Information > Bluetooth).
DEVICES="AA:BB:CC:DD:EE:01, AA:BB:CC:DD:EE:02"

# VCP 0x60 value the monitor reports for the Mac mini's input.
HDMI_INPUT=18
