# install.sh writes install.conf (kept out of git) when it is missing; or copy
# this file to install.conf and fill it in. Plain KEY=value lines;
# the file is read, not run.

# The two Macs as user@host. install.sh logs in to the other Mac with ssh
# once to install there; afterwards the agents reach each other by the host
# part (the .local name) over HTTP. install.sh runs on either Mac and finds
# out which one it is on; the line for that Mac may be left out
# ($USER@<LocalHostName>.local), the other Mac's line is required.
# (MINI_FROM and MACBOOK_FROM from older versions are ignored.)
MINI=user@mac-mini.local
MACBOOK=user@macbook.local

# Bluetooth addresses to hand over, keyboard first (see System Information > Bluetooth).
DEVICES="AA:BB:CC:DD:EE:01, AA:BB:CC:DD:EE:02"

# VCP 0x60 value the monitor reports for the Mac mini's input.
HDMI_INPUT=18
