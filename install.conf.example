# Copy to install.conf (kept out of git) and fill in. Plain KEY=value lines;
# the file is read, not run.

# How this MacBook reaches the Mac mini over ssh.
MINI=user@100.64.0.2

# How the Mac mini reaches this MacBook. Defaults to $USER@<LocalHostName>.local;
# with Tailscale SSH enabled on the MacBook its Tailscale address cannot be used.
#MACBOOK=user@macbook.local

# The addresses each agent's ssh key is accepted from. List each Mac's exact
# addresses (its Tailscale address, a DHCP-reserved LAN address, and for a
# .local name its link-local IPv6 address, also as "fe80::…%*", the form sshd
# may see it in); a whole subnet would let any
# device on it use a stolen key. MACBOOK_FROM defaults to any address.
MINI_FROM="100.64.0.2,192.168.1.20,fe80::1234:5678:9abc:def0"
#MACBOOK_FROM="100.64.0.1,192.168.1.10"

# Bluetooth addresses to hand over, keyboard first (see System Information > Bluetooth).
DEVICES="AA:BB:CC:DD:EE:01, AA:BB:CC:DD:EE:02"

# VCP 0x60 value the monitor reports for the Mac mini's input.
HDMI_INPUT=18
